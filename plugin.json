{
  "id": "remotehand.editor",
  "name": "RemoteHand Editor",
  "version": "0.1.0",
  "apiVersion": 1,
  "author": "RemoteHand",
  "description": "A lightweight programmer-focused text editor for RemoteHand.",
  "runtime": {
    "kind": "executable",
    "entrypoints": {
      "windows-x86_64": "bin/windows-x86_64/remotehand-editor.exe",
      "linux-x86_64": "bin/linux-x86_64/remotehand-editor",
      "linux-aarch64": "bin/linux-aarch64/remotehand-editor"
    }
  },
  "permissions": [
    "storage.plugin",
    "files.save"
  ],
  "contributes": {
    "sidebar": [
      {
        "id": "editor",
        "title": "Editor",
        "icon": "assets/sidebar.svg",
        "panel": "editor"
      }
    ],
    "panels": [
      {
        "id": "editor",
        "title": "Editor",
        "entry": "ui/index.html"
      }
    ],
    "commands": [
      {
        "id": "open",
        "title": "Open Editor"
      }
    ]
  }
}
